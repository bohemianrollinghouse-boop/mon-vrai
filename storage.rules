rules_version = '2';

// Les médias publiés (photos produits, images de pages) sont lisibles par tous.
// L'envoi passe par le serveur, qui contrôle le type et la taille : pas d'écriture cliente.
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Factures : privées, servies par le serveur après vérification du propriétaire.
    match /invoices/{allPaths=**} {
      allow read, write: if false;
    }

    // Pièces administratives (normes CE, laboratoire, ISBN, contrats) : privées, servies
    // par /api/documents/<id> après vérification de l'administrateur.
    //
    // L'ÉCRITURE y est ouverte à un administrateur connecté, pour la même raison que
    // sous `ugc/` : un rapport de laboratoire scanné pèse couramment plus de quinze
    // mégaoctets, et le faire transiter par une action serveur le fait traverser trois
    // fois la mémoire d'une instance qui n'a qu'un gigaoctet. Le dépôt échouait alors
    // sans un mot — une page d'erreur nue, rien en base, rien dans le coffre.
    //
    // La lecture, elle, reste fermée : c'est toute la différence avec `media/`. Rien de
    // ce dossier n'a d'adresse publique, et /api/documents/<id> en est la seule porte.
    // Et rien n'est inscrit en base avant que le serveur ait relu le type et la taille
    // RÉELS de l'objet arrivé (db/documents.recordDocument).
    match /documents/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource != null
        && request.resource.size <= 40 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/csv')
          || request.resource.contentType.matches('application/vnd.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType == 'application/x-zip-compressed'
        );
    }

    // Contenus rendus par les partenaires (photos et vidéos d'une campagne) : privés
    // comme les factures. L'ÉCRITURE y est ouverte, à un administrateur connecté
    // seulement, et c'est la seule du projet : une vidéo de partenaire dépasse ce
    // qu'une action serveur accepte (45 Mo) et ce que l'instance peut tenir en mémoire,
    // elle va donc au coffre directement depuis le navigateur. Rien n'en est inscrit en
    // base tant que le serveur n'a pas relu le type et la taille RÉELS de l'objet
    // (db/deliverables.recordDeliverable) ; ce qui n'est ni photo ni vidéo y est effacé.
    // La taille est répétée ici depuis MAX_CONTENT_BYTES : seules les règles peuvent la
    // faire respecter avant l'envoi.
    match /ugc/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource != null
        && request.resource.size <= 500 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
