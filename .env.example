# ============================================================================
#  Mon Vrai — variables d'environnement
#
#  Copier ce fichier en `.env.local` (développement) et le compléter.
#  En production, les valeurs publiques vont dans apphosting.yaml, les secrets dans
#  Secret Manager (`firebase apphosting:secrets:set NOM`). Ce fichier ne contient
#  aucun secret et est versionné ; les `.env.local` ne le sont jamais.
#
#  Légende :  [DEV]  utile en local   ·   [PROD]  requis en production
#             [PUBLIC] exposé au navigateur (préfixe NEXT_PUBLIC_, jamais un secret)
# ============================================================================


# ---------------------------------------------------------------------------
#  Site
# ---------------------------------------------------------------------------

# [DEV+PROD][PUBLIC] URL publique, sans slash final. Sert aux liens absolus (e-mails,
# retour Stripe, métadonnées).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
#  Firebase — projet
#  Console : https://console.firebase.google.com → ton projet → ⚙ Paramètres du projet
#  → onglet Général → section « Vos applications » → app Web → « Configuration ».
# ---------------------------------------------------------------------------

# [DEV+PROD][PUBLIC] Identifiant du projet (prod : mon-vrai). En dev : mon-vrai-dev.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mon-vrai-dev

# [PROD][PUBLIC] Clé d'API Web — `apiKey` de la config. Publique par nature ; c'est
# les règles Firestore/Storage et les domaines autorisés qui protègent, pas la clé.
# En dev avec émulateurs : laisser vide, une valeur factice est utilisée.
NEXT_PUBLIC_FIREBASE_API_KEY=

# [PROD][PUBLIC] `authDomain` de la config (prod : mon-vrai.firebaseapp.com).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# [DEV+PROD] Nom du bucket Storage, sans gs:// (prod : mon-vrai.firebasestorage.app).
# Console → Storage → l'URL en haut. En dev : mon-vrai-dev.appspot.com.
FIREBASE_STORAGE_BUCKET=mon-vrai-dev.appspot.com

# [DEV] Émulateurs. Laisser VIDES en production : le serveur utilise alors les
# identifiants fournis par App Hosting automatiquement.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# [DEV][PUBLIC] Dit au navigateur de viser l'émulateur Auth. 1 = oui. Vide en production.
NEXT_PUBLIC_USE_EMULATORS=1

# [optionnel] Pour lancer le seed ou make-admin contre le VRAI projet depuis ce Mac :
# chemin d'un fichier de compte de service (Console → ⚙ → Comptes de service →
# « Générer une nouvelle clé privée »). À garder hors du dépôt.
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/mon-vrai-xxxx.json


# ---------------------------------------------------------------------------
#  Stripe
#  Tableau de bord : https://dashboard.stripe.com → Développeurs → Clés API.
#  Commencer en mode TEST (bascule en haut à droite) ; passer en LIVE le jour J.
# ---------------------------------------------------------------------------

# [DEV+PROD][SECRET] Clé secrète : sk_test_… en test, sk_live_… en production.
STRIPE_SECRET_KEY=

# [DEV+PROD][SECRET] Secret de signature du webhook : whsec_…
#   Production : Développeurs → Webhooks → « Ajouter un point de terminaison »
#     URL : https://TON-DOMAINE/api/stripe/webhook
#     Événements : checkout.session.completed, checkout.session.async_payment_succeeded
#   Dev : `stripe listen --forward-to localhost:3000/api/stripe/webhook` affiche un whsec_.
STRIPE_WEBHOOK_SECRET=

# [PROD][SECRET] Même chose pour le mode TEST (sk_test_… et le whsec_ d'un point de
# terminaison créé en mode test). L'admin choisit le mode dans Réglages → Paiements ;
# les commandes de test sont marquées comme telles et n'ont pas de facture.
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

# [DEV+PROD] Clés publiables (pk_live_… / pk_test_…) : Développeurs → Clés API. Publiques par
# nature ; servies au navigateur par la page de paiement selon le mode choisi dans l'admin.
STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY_TEST=

# [PROD] 1 = calcul automatique de la TVA par Stripe Tax (à activer d'abord dans
# Stripe → Paramètres → Tax, avec ton numéro de TVA et tes pays de vente). 0 = désactivé.
STRIPE_TAX=0


# ---------------------------------------------------------------------------
#  E-mails transactionnels — Resend (https://resend.com)
#  Sans clé, les e-mails sont écrits dans les logs au lieu d'être envoyés.
# ---------------------------------------------------------------------------

# [PROD][SECRET] Resend → API Keys → « Create API key ».
RESEND_API_KEY=

# [PROD] Expéditeur. Le DOMAINE doit être vérifié dans Resend → Domains (il te donnera
# les enregistrements DNS SPF/DKIM/DMARC à poser chez ton registrar).
EMAIL_FROM="Mon Vrai <no-reply@monvrai.fr>"

# [PROD] Boîte qui reçoit les messages du formulaire de contact.
CONTACT_INBOX=contact@monvrai.fr


# ---------------------------------------------------------------------------
#  Administration
# ---------------------------------------------------------------------------

# [DEV] Compte admin créé par `pnpm seed` dans l'émulateur Auth. Jamais en production :
# là, on utilise `pnpm make-admin ton@email.fr` après s'être inscrit sur le site.
ADMIN_SEED_EMAIL=admin@monvrai.local
ADMIN_SEED_PASSWORD=admin-local-only


# ---------------------------------------------------------------------------
#  Boxtal — étiquettes, suivi, carte des points relais (https://developer.boxtal.com)
#  Deux applications à créer dans l'app Développeur : « API v3 » et « Composant carte ».
# ---------------------------------------------------------------------------

# [PROD][SECRET] Application API v3 : clé d'accès et clé secrète.
BOXTAL_ACCESS_KEY=
BOXTAL_SECRET_KEY=

# [PROD][SECRET] Application Composant carte : clé d'accès et clé secrète (jeton de la carte).
BOXTAL_MAP_ACCESS_KEY=
BOXTAL_MAP_SECRET_KEY=

# [PROD][SECRET] Secret choisi par nous, déclaré à Boxtal avec les souscriptions webhook
# (`pnpm boxtal:subscribe`) ; sert à vérifier l'en-tête x-bxt-signature.
BOXTAL_WEBHOOK_SECRET=

# [optionnel] https://api.boxtal.build pour l'environnement de test Boxtal (compte distinct).
# BOXTAL_API_URL=https://api.boxtal.com


# ---------------------------------------------------------------------------
#  Make (scénario Tiime) — chaque commande payée est envoyée au webhook Make,
#  qui crée le client et la facture dans Tiime.
# ---------------------------------------------------------------------------

# [PROD][SECRET] URL du webhook Make (qui la connaît peut déclencher le scénario).
MAKE_WEBHOOK_URL=
# [PROD][SECRET] Clé transmise en en-tête x-make-apikey (en-tête attendu par Make).
MAKE_WEBHOOK_API_KEY=
