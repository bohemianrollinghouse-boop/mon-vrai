rules_version = '2';

// Le serveur (firebase-admin) passe outre ces règles : tout ce qui écrit passe par lui.
// Ces règles ne couvrent donc que ce que le navigateur peut lire directement.
// Principe : le catalogue et le contenu publiés sont publics, le reste est fermé.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Contenu publié : lecture publique, écriture réservée au serveur.
    match /products/{slug} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if false;
    }

    match /pages/{slug} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if false;
    }

    match /menus/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /media/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Données personnelles : un client ne voit que les siennes.
    match /customers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    // Paniers, compteurs, journaux : serveur uniquement.
    match /carts/{id} {
      allow read, write: if false;
    }

    match /counters/{id} {
      allow read, write: if false;
    }

    // Fréquentation : agrégats anonymes et présence, serveur uniquement.
    match /stats_days/{id} {
      allow read, write: if false;
    }

    match /stats_presence/{id} {
      allow read, write: if false;
    }

    match /audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
